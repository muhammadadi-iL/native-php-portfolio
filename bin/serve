#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8080}"
PHP_BIN="${PHP_BIN:-$(command -v php)}"

if [[ -z "$PHP_BIN" ]]; then
  echo "php not found. Install with: brew install php" >&2
  exit 1
fi

echo "Muhammad Adil portfolio (native PHP)"
echo "→ http://${HOST}:${PORT}/"
echo "PHP: $($PHP_BIN -v | head -1)"
exec "$PHP_BIN" -S "${HOST}:${PORT}" -t public public/router.php
